{
  "name": "align",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "CACHEBUST": "1"
    }
  },
  "runArgs": [
    "--gpus=all",
    "--name=align",
    "--ipc=host",
    "--runtime=nvidia"
  ],
  "hostRequirements": {
    "gpu": true
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/align/bin/python",
        "python.analysis.extraPaths": [
          "/workspace/align",
          "/workspace/align/fairseq"
        ],
        "python.analysis.indexing": true,
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "mechatroner.rainbow-csv"
      ]
    }
  },
  "workspaceFolder": "/workspace/align",
  "mounts": [
    "source=${localWorkspaceFolder}/ALIGN_Weights,target=/workspace/align/model_weights,type=bind,consistency=cached"
  ],
  "remoteUser": "root",
  "overrideCommand": true
}
